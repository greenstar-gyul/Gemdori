<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gemdori.main.mapper.GameMapper">

  <!-- 검색 + 페이징 -->
  <select id="searchGames" parameterType="map" resultType="com.gemdori.vo.GameVO">
    SELECT * FROM (
      SELECT inner_q.*, ROWNUM rnum
      FROM (
        SELECT * 
          FROM gemdori_game_tbl
         WHERE 1=1
           <if test="dto.keyword != null and dto.keyword != ''">
             AND game_title LIKE '%' || #{dto.keyword} || '%'
           </if>
           <if test="dto.genres != null and dto.genres != ''">
             AND game_genre = #{dto.genres}
           </if>
           <!-- …추가 필터… -->
         ORDER BY publishing_date DESC
      ) inner_q
      WHERE ROWNUM &lt;= #{offset} + #{limit}
    )
    WHERE rnum &gt; #{offset}
  </select>

  <!-- 전체 개수 -->
  <select id="countSearchGames"
          parameterType="com.gemdori.main.SearchDTO"
          resultType="int">
    SELECT COUNT(*) FROM gemdori_game_tbl
     WHERE 1=1
       <if test="keyword != null and keyword != ''">
         AND game_title LIKE '%' || #{keyword} || '%'
       </if>
       <if test="genres != null and genres != ''">
         AND game_genre = #{genres}
       </if>
       <!-- …추가 필터… -->
  </select>

  <!-- 단건 조회 -->
  <select id="getGameByCode"
          parameterType="string"
          resultType="com.gemdori.vo.GameVO">
    SELECT * FROM gemdori_game_tbl
     WHERE game_code = #{gameCode}
  </select>
</mapper>
